{
  "name": "chat-error-server-error-header",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "server-error"
      }
    }
  },
  "response": {
    "status": 500,
