{
  "name": "chat-error-rate-limit-header",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "headers": {
      "X-Mock-Scenario": {
        "equalTo": "rate-limit"
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "1"
    },
    "bodyFileName": "error-rate-limit.json"
  }
}
