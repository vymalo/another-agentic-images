{
  "name": "responses-error-rate-limit-text",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/responses",
    "bodyPatterns": [
      {
        "contains": "[mock:rate-limit]"
      }
    ]
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "1"
    },
    "bodyFileName": "error-rate-limit.json"
  }
}
