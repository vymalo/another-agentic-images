{
  "name": "chat-tool-call-stream",
  "priority": 3,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "bodyPatterns": [
      {
        "contains": "[mock:tool-call]"
      },
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache"
    },
    "bodyFileName": "chat-stream-tool-call.txt"
  }
}
